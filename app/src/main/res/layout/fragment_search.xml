<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/background"
    tools:context=".fragments.User.View.Others.SearchFragment">

    <androidx.appcompat.widget.LinearLayoutCompat
        android:id="@+id/idAppBar"
        android:layout_width="match_parent"
        android:layout_height="@dimen/_90sdp"
        android:background="@drawable/bg_appbar"
        android:orientation="horizontal"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/ivBack"
            android:layout_width="@dimen/_25sdp"
            android:layout_height="@dimen/_25sdp"
            android:layout_marginTop="@dimen/_10sdp"
            android:src="@drawable/ic_backspace"
            android:tint="@color/white"
            android:layout_marginStart="@dimen/_10sdp"
            android:layout_gravity="center|center_horizontal"/>

        <androidx.appcompat.widget.AppCompatEditText
            android:id="@+id/etSearchView"
            android:layout_width="match_parent"
            android:layout_height="@dimen/_50sdp"
            android:layout_marginHorizontal="@dimen/_8sdp"
            android:layout_marginTop="@dimen/_10sdp"
            android:layout_weight="1"
            android:layout_gravity="center"
            android:background="@drawable/bg_card_admin"
            android:backgroundTint="@color/white"
            android:fontFamily="@font/poppins_medium"
            android:hint="@string/search_here_any_books"
            android:paddingHorizontal="@dimen/_8sdp"
            android:textColor="@color/black"
            android:textColorHint="@color/textHint"
            android:textSize="@dimen/_12sdp"
            android:textStyle="bold"
            tools:ignore="TextSizeCheck">

        </androidx.appcompat.widget.AppCompatEditText>

    </androidx.appcompat.widget.LinearLayoutCompat>

    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/ivNotFound"
        android:layout_width="@dimen/_200sdp"
        android:layout_height="@dimen/_200sdp"
        android:src="@drawable/ic_search_empty"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/idAppBar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/tvNoBookFound"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/no_book_found"
        android:textStyle="bold"
        android:textSize="@dimen/_16sdp"
        android:textColor="@color/teal"
        android:fontFamily="@font/red_rose"
        app:layout_constraintTop_toBottomOf="@+id/ivNotFound"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/idRecyclerSearch"
        android:layout_width="0dp"
        android:layout_height="0dp"
        tools:listitem="@layout/item_book_user"
        android:layout_margin="@dimen/_12sdp"
        android:visibility="gone"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/idAppBar"/>

</androidx.constraintlayout.widget.ConstraintLayout>