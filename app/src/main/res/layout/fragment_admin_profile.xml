<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/background"
    tools:context=".fragments.Admin.View.Profile.AdminProfileFragment">

    <RelativeLayout android:id="@+id/idAppBar"
        android:layout_width="match_parent"
        android:layout_height="@dimen/_140sdp"
        android:background="@drawable/bg_appbar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/ivBack"
            android:layout_width="@dimen/_26sdp"
            android:layout_height="@dimen/_26sdp"
            android:layout_alignParentStart="true"
            android:layout_alignParentTop="true"
            android:layout_marginStart="24dp"
            android:layout_marginTop="34dp"
            android:src="@drawable/ic_backspace"
            android:tint="@color/white"
            android:tooltipText="Menu" />

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tvAppName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_alignParentTop="true"
            android:layout_alignParentBottom="true"
            android:layout_alignParentEnd="true"
            android:layout_marginTop="@dimen/_20sdp"
            android:layout_marginBottom="@dimen/_20sdp"
            android:fontFamily="@font/dangrek"
            android:gravity="top|center"
            android:textColor="@color/white"
            android:textSize="@dimen/_20sdp"
            android:textStyle="bold" />

    </RelativeLayout>


    <androidx.cardview.widget.CardView
        android:id="@+id/idCardViewProfile"
        android:layout_width="@dimen/_100sdp"
        android:layout_height="@dimen/_100sdp"
        app:cardCornerRadius="@dimen/_50sdp"
        app:cardBackgroundColor="@color/black"
        android:layout_marginTop="@dimen/_minus60sdp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/idAppBar">

        <androidx.appcompat.widget.AppCompatImageView
            android:layout_width="@dimen/_70sdp"
            android:layout_height="@dimen/_70sdp"
            android:layout_gravity="center"
            android:scaleType="centerCrop"
            android:src="@drawable/user"
            android:tint="#F0EDED"/>

    </androidx.cardview.widget.CardView>

    <androidx.appcompat.widget.AppCompatImageView
        android:layout_width="@dimen/_16sdp"
        android:layout_height="@dimen/_16sdp"
        android:src="@drawable/ic_edit"
        android:tint="@color/teal"
        android:layout_marginEnd="@dimen/_5sdp"
        app:layout_constraintBottom_toBottomOf="@+id/tvEditText"
        app:layout_constraintEnd_toStartOf="@+id/tvEditText"
        app:layout_constraintVertical_bias="0.9"
        app:layout_constraintTop_toBottomOf="@+id/idCardViewProfile" />

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/tvEditText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Edit Your Profile"
        android:textSize="@dimen/_11sdp"
        android:textStyle="bold"
        android:textColor="@color/teal"
        android:gravity="center"
        android:layout_marginTop="@dimen/_8sdp"
        app:layout_constraintTop_toBottomOf="@+id/idCardViewProfile"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <View
        android:id="@+id/idView1"
        android:layout_width="match_parent"
        android:layout_height="@dimen/_1sdp"
        android:background="@color/teal"
        android:layout_marginTop="@dimen/_18sdp"
        android:layout_marginBottom="@dimen/_12sdp"
        android:layout_marginHorizontal="@dimen/_12sdp"
        app:layout_constraintTop_toBottomOf="@+id/tvEditText"/>

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/tvDetails"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Library Details"
        android:textColor="@color/teal"
        android:textStyle="bold"
        android:fontFamily="@font/poppins_medium"
        android:textSize="@dimen/_15sdp"
        android:gravity="center"
        app:layout_constraintTop_toBottomOf="@+id/idView1"
        app:layout_constraintBottom_toBottomOf="@+id/idView2"/>

    <View
        android:id="@+id/idView2"
        android:layout_width="match_parent"
        android:layout_height="@dimen/_1sdp"
        android:background="@color/teal"
        android:layout_marginVertical="@dimen/_6sdp"
        android:layout_marginHorizontal="@dimen/_12sdp"
        app:layout_constraintTop_toBottomOf="@+id/tvDetails"/>

    <androidx.appcompat.widget.LinearLayoutCompat
        android:id="@+id/idLiner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginStart="25sp"
        android:layout_marginEnd="25sp"
        android:layout_marginTop="10sp"
        android:layout_marginBottom="10sp"
        android:padding="5sp"
        app:layout_constraintTop_toBottomOf="@+id/idView2">

        <androidx.appcompat.widget.AppCompatTextView
            android:layout_width="120sp"
            android:layout_height="match_parent"
            android:text="Library Name"
            android:textColor="#494444"
            android:gravity="center_vertical"
            android:textSize="@dimen/_15sdp"
            android:textStyle="bold" />

        <androidx.appcompat.widget.AppCompatTextView
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:text=":"
            android:textColor="#494444"
            android:gravity="center"
            android:paddingHorizontal="@dimen/_6sdp"
            android:layout_gravity="center_vertical"
            android:layout_marginEnd="5sp"
            android:textSize="20sp"
            android:textStyle="bold" />

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tvLibraryName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="NA"
            android:textSize="18sp"
            android:gravity="center_vertical"
            android:layout_gravity="center_vertical"
            android:singleLine="true"
            android:textColor="#494444"
            android:textStyle="bold" />

    </androidx.appcompat.widget.LinearLayoutCompat>

    <androidx.appcompat.widget.LinearLayoutCompat
        android:id="@+id/linearLayoutCompat3"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_8sdp"
        android:layout_marginHorizontal="@dimen/_18sdp"
        android:orientation="horizontal"
        android:padding="@dimen/_4sdp"
        app:layout_constraintTop_toBottomOf="@+id/idLiner">

        <androidx.appcompat.widget.AppCompatTextView
            android:layout_width="120sp"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:text="Library No."
            android:textColor="#494444"
            android:textSize="@dimen/_15sdp"
            android:textStyle="bold" />

        <androidx.appcompat.widget.AppCompatTextView
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_gravity="center_vertical"
            android:layout_marginEnd="5sp"
            android:gravity="center"
            android:paddingHorizontal="@dimen/_6sdp"
            android:text=":"
            android:textColor="#494444"
            android:textSize="20sp"
            android:textStyle="bold" />

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tvLibraryNo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:gravity="center_vertical"
            android:singleLine="true"
            android:text="NA"
            android:textColor="#494444"
            android:textSize="18sp"
            android:textStyle="bold" />

    </androidx.appcompat.widget.LinearLayoutCompat>

    <View
        android:id="@+id/idView3"
        android:layout_width="match_parent"
        android:layout_height="@dimen/_1sdp"
        android:layout_marginTop="@dimen/_18sdp"
        android:layout_marginBottom="@dimen/_12sdp"
        android:layout_marginHorizontal="@dimen/_12sdp"
        android:background="@color/teal"
        app:layout_constraintTop_toBottomOf="@+id/linearLayoutCompat3"
        tools:layout_editor_absoluteX="16dp" />

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/tvDetail"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Contact Details"
        android:textColor="@color/teal"
        android:textStyle="bold"
        android:fontFamily="@font/poppins_medium"
        android:textSize="@dimen/_15sdp"
        android:gravity="center"
        app:layout_constraintTop_toBottomOf="@+id/idView3"
        app:layout_constraintBottom_toBottomOf="@+id/idView4"/>

    <View
        android:id="@+id/idView4"
        android:layout_width="match_parent"
        android:layout_height="@dimen/_1sdp"
        android:background="@color/teal"
        android:layout_marginVertical="@dimen/_6sdp"
        android:layout_marginHorizontal="@dimen/_12sdp"
        app:layout_constraintTop_toBottomOf="@+id/tvDetail"/>

    <androidx.appcompat.widget.LinearLayoutCompat
        android:id="@+id/idLiner1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginStart="25sp"
        android:layout_marginEnd="25sp"
        android:layout_marginTop="10sp"
        android:layout_marginBottom="10sp"
        android:padding="5sp"
        app:layout_constraintTop_toBottomOf="@+id/idView4">

        <androidx.appcompat.widget.AppCompatTextView
            android:layout_width="120sp"
            android:layout_height="match_parent"
            android:text="Address"
            android:textColor="#494444"
            android:gravity="center_vertical"
            android:textSize="@dimen/_15sdp"
            android:textStyle="bold" />

        <androidx.appcompat.widget.AppCompatTextView
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:text=":"
            android:textColor="#494444"
            android:gravity="center"
            android:paddingHorizontal="@dimen/_6sdp"
            android:layout_gravity="center_vertical"
            android:layout_marginEnd="5sp"
            android:textSize="20sp"
            android:textStyle="bold" />

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tvLibraryAddress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="NA"
            android:textSize="18sp"
            android:gravity="center_vertical"
            android:layout_gravity="center_vertical"
            android:singleLine="true"
            android:textColor="#494444"
            android:textStyle="bold" />

    </androidx.appcompat.widget.LinearLayoutCompat>

    <androidx.appcompat.widget.LinearLayoutCompat
        android:id="@+id/idLiner2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginStart="25sp"
        android:layout_marginEnd="25sp"
        android:layout_marginTop="10sp"
        android:layout_marginBottom="10sp"
        android:padding="5sp"
        app:layout_constraintTop_toBottomOf="@+id/idLiner1">

        <androidx.appcompat.widget.AppCompatTextView
            android:layout_width="120sp"
            android:layout_height="match_parent"
            android:text="Contact No."
            android:textColor="#494444"
            android:gravity="center_vertical"
            android:textSize="@dimen/_15sdp"
            android:textStyle="bold" />

        <androidx.appcompat.widget.AppCompatTextView
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:text=":"
            android:textColor="#494444"
            android:gravity="center"
            android:paddingHorizontal="@dimen/_6sdp"
            android:layout_gravity="center_vertical"
            android:layout_marginEnd="5sp"
            android:textSize="20sp"
            android:textStyle="bold" />

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tvPhoneNo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="NA"
            android:textSize="18sp"
            android:gravity="center_vertical"
            android:layout_gravity="center_vertical"
            android:singleLine="true"
            android:textColor="#494444"
            android:textStyle="bold" />

    </androidx.appcompat.widget.LinearLayoutCompat>

    <RelativeLayout
        android:id="@+id/btnLogOut"
        android:layout_width="match_parent"
        android:layout_height="@dimen/_35sdp"
        android:layout_margin="@dimen/_40sdp"
        android:background="@drawable/bg_btn"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/idLiner2">

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tvBtnName"
            android:layout_width="match_parent"
            android:layout_height="@dimen/_35sdp"
            android:elevation="@dimen/_6sdp"
            android:gravity="center"
            android:text="Log out"
            android:textColor="@color/white"
            android:textSize="@dimen/_16sdp"
            android:textStyle="bold" />

        <ProgressBar
            android:id="@+id/idProgressBar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:indeterminateTint="@color/white"
            android:visibility="gone" />

    </RelativeLayout>


</androidx.constraintlayout.widget.ConstraintLayout>